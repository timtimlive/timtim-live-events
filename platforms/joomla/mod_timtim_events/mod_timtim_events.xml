<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>TimTim.Live Events</name>
	<author>TimTim.Live</author>
	<authorUrl>https://timtim.live/developers</authorUrl>
	<version>0.1.0</version>
	<license>MIT</license>
	<description>Show live events from TimTim.Live. Choose the city, type and layout, then place the module in any template position.</description>
	<files>
		<filename module="mod_timtim_events">mod_timtim_events.php</filename>
		<filename>helper.php</filename>
		<folder>tmpl</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="location" type="text" default="Miami,US" label="Location" description="A city, or City,CC — for example Miami,US or Paris,FR." maxlength="120" filter="string" />
				<field name="category" type="list" default="music" label="Event type">
					<option value="">Any</option>
					<option value="music">Music</option>
					<option value="festival">Festival</option>
					<option value="nightlife">Nightlife</option>
					<option value="conference">Conference</option>
				</field>
				<field name="limit" type="number" default="6" min="1" max="24" step="1" label="How many" filter="integer" />
				<field name="events_layout" type="list" default="grid" label="Layout">
					<option value="grid">Cards</option>
					<option value="list">List</option>
					<option value="compact">Compact</option>
				</field>
				<field name="theme" type="list" default="light" label="Colors">
					<option value="light">Light</option>
					<option value="dark">Dark</option>
					<option value="auto">Match visitor</option>
				</field>
				<field name="color" type="color" default="#0e7490" label="Button color" />
				<field name="show_images" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show pictures">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_price" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show prices">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="partner_key" type="text" default="" label="TimTim.Live website key" description="Optional. Your website key (tt_pk_live_…) shows real events and counts clicks for you. Leave empty for sample events. Never a server key." filter="string" />
			</fieldset>
		</fields>
	</config>
</extension>
